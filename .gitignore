# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/
.turbo/

# env
.env
.env*.local
# Hand-made backups of the above. `.env*.local` does not match `.env.local.bak`,
# so without this a stray `git add -A` commits a file full of live secrets.
*.bak

# logs / os
*.log
npm-debug.log*
.DS_Store

# next generated
next-env.d.ts
*.tsbuildinfo

# Generated by scripts/sync-hub-agents.mjs from the hub — the hub is the source
# of truth, so these are never committed. See docs/local-agents.md.
.claude/agents/hub-*.md
.claude/skills/hub-*/
.claude/.hub-sync.json
