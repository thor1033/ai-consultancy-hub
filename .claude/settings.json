{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run migrate:*)",
      "Bash(node --env-file=apps/web/.env.local scripts/db-query.mjs:*)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./apps/web/.env.local)",
      "Read(./**/*.bak)",
      "Bash(git push origin master:*)",
      "Bash(flyctl deploy:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sync-hub-agents.mjs\" --hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hub-work-log.mjs\" --start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hub-work-log.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
