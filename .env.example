# Copy to .env.local (never commit real secrets).

# --- Web ---
NODE_ENV=development
PORT=3000

# --- Claude / Agent runtime (Thing 2) ---
# ANTHROPIC_API_KEY=

# --- LLM observability + ROI data (Thing 2) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database: Postgres + pgvector (Thing 4/5) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aihub

# --- Embeddings (Thing 5) ---
# VOYAGE_API_KEY=

# --- Security / AuthZ (Thing 6) ---
# Bearer tokens → principals. Fails closed: unset ⇒ every request is 401.
# (MVP secrets store; a real secrets manager + WorkOS SSO come in Phase 2.)
# HUB_API_TOKENS={"tok-admin":{"id":"admin","roles":["admin"]},"tok-analyst":{"id":"analyst","roles":["analyst"]},"tok-viewer":{"id":"viewer","roles":["viewer"]}}
