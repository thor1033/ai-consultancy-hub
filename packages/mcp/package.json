{
  "name": "@ai-hub/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pptx-template": {
      "types": "./pptx-template/index.d.ts",
      "default": "./pptx-template/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "mcp:sample": "node sample-server/server.mjs",
    "mcp:remote-fixture": "node remote-fixture/server.mjs",
    "verify": "node verify.mjs",
    "verify:demo": "node verify-demo.mjs",
    "verify:remote": "node verify-remote.mjs",
    "verify:pptx-template": "node verify-pptx-template.mjs",
    "verify:memory": "node verify-memory.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.4.3",
    "postgres": "^3.4.9"
  }
}
